# ──────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in real values.
#   cp .env.example .env
# ".env" is git-ignored — never commit real secrets.
# ──────────────────────────────────────────────────────────────

# ── Mail (SMTP) ──
KC_MAIL_HOST=smtp.example.com
KC_MAIL_PORT=587
KC_MAIL_FROM=no-reply@example.com
KC_MAIL_USER=
KC_MAIL_PASSWORD=
KC_MAIL_AUTH=true
KC_MAIL_STARTTLS=true

# ── Backend OAuth client (Keycloak confidential client) ──
KC_BACKEND_CLIENT_SECRET=change-me
BACKEND_CLIENT_ID=hireAI-backend

# ── GitHub (CV enrichment — personal access token) ──
GITHUB_TOKEN=

# ── Google Calendar (interview sync — OAuth Web client) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/google-callback

# ── Keycloak admin (bootstrap) ──
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# ── Database credentials ──
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
JOB_DB_USER=jobuser
JOB_DB_PASSWORD=change-me
APP_DB_USER=appuser
APP_DB_PASSWORD=change-me
AUDIT_DB_USER=audituser
AUDIT_DB_PASSWORD=change-me
NOTIFICATION_DB_USER=notificationuser
NOTIFICATION_DB_PASSWORD=change-me
INTERVIEW_DB_USER=interviewuser
INTERVIEW_DB_PASSWORD=change-me
